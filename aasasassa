[32m+[m[32m## Services[m
[32m+[m
[32m+[m[32m### Auth Service (Port 8001)[m
[32m+[m[32m- JWT-based authentication[m
[32m+[m[32m- User registration and login[m
[32m+[m[32m- Token verification[m
[32m+[m[32m- Session management[m
[32m+[m
[32m+[m[32m**Endpoints:**[m
[32m+[m[32m- `POST /signup` - Register new user[m
[32m+[m[32m- `POST /login` - Authenticate user[m
[32m+[m[32m- `POST /verify` - Verify JWT token[m
[32m+[m[32m- `GET /me` - Get current user[m
[32m+[m[32m- `POST /logout` - Invalidate session[m
[32m+[m
[32m+[m[32m### API Gateway (Port 8000)[m
[32m+[m[32m- Central routing for all services[m
[32m+[m[32m- Rate limiting (configurable)[m
[32m+[m[32m- Circuit breaker per service[m
[32m+[m[32m- Request/response metrics[m
[32m+[m
[32m+[m[32m**Endpoints:**[m
[32m+[m[32m- `GET /api/services` - List service status[m
[32m+[m[32m- `/api/auth/*` - Proxy to auth service[m
[32m+[m[32m- `/api/orders/*` - Proxy to order service[m
[32m+[m[32m- `/api/payments/*` - Proxy to payment service[m
[32m+[m[32m- `/api/inventory/*` - Proxy to inventory service[m
[32m+[m[32m- `/api/notifications/*` - Proxy to notification service[m
[32m+[m
[32m+[m[32m### Order Service (Port 8002)[m
[32m+[m[32m- Order creation and management[m
[32m+[m[32m- Orchestrates payment, inventory, notification[m
[32m+[m[32m- PostgreSQL-backed persistence[m
[32m+[m
[32m+[m[32m**Endpoints:**[m
[32m+[m[32m- `POST /orders` - Create order[m
[32m+[m[32m- `GET /orders` - List orders[m
[32m+[m[32m- `GET /orders/{id}` - Get order details[m
[32m+[m[32m- `PUT /orders/{id}/cancel` - Cancel order[m
[32m+[m
[32m+[m[32m### Payment Service (Port 8003)[m
[32m+[m[32m- Simulated payment processing[m
[32m+[m[32m- Configurable failure rate[m
[32m+[m[32m- Transaction history[m
[32m+[m
[32m+[m[32m**Endpoints:**[m
[32m+[m[32m- `POST /pay` - Process payment[m
[32m+[m[32m- `GET /payments/{id}` - Get payment status[m
[32m+[m[32m- `GET /payments/order/{id}` - Get payments for order[m
[32m+[m[32m- `POST /payments/{id}/refund` - Refund payment[m
[32m+[m[32m- `GET /stats` - Payment statistics[m
[32m+[m
[32m+[m[32m### Inventory Service (Port 8004)[m
[32m+[m[32m- Redis-backed stock management[m
[32m+[m[32m- In-memory fallback[m
[32m+[m[32m- Reservation system[m
[32m+[m
[32m+[m[32m**Endpoints:**[m
[32m+[m[32m- `GET /stock` - List all inventory[m
[32m+[m[32m- `GET /stock/{id}` - Get item stock[m
[32m+[m[32m- `POST /reserve/{id}` - Reserve stock[m
[32m+[m[32m- `POST /decrease/{id}` - Decrease stock[m
[32m+[m[32m- `POST /increase/{id}` - Restock[m
[32m+[m[32m- `GET /search?q=` - Search items[m
[32m+[m[32m- `GET /low-stock` - Low stock alerts[m
[32m+[m
[32m+[m[32m### Notification Service (Port 8005)[m
[32m+[m[32m- Async queue-based processing[m
[32m+[m[32m- Multiple notification types[m
[32m+[m[32m- Bulk sending support[m
[32m+[m
[32m+[m[32m**Endpoints:**[m
[32m+[m[32m- `POST /notify` - Send notification (sync)[m
[32m+[m[32m- `POST /notify/async` - Queue notification[m
[32m+[m[32m- `POST /notify/bulk` - Bulk send[m
[32m+[m[32m- `GET /notifications` - List sent notifications[m
[32m+[m[32m- `GET /stats` - Notification statistics[m
